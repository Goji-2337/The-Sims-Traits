<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Vanilla Traits Expanded</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAdd">
					<xpath>Defs</xpath>
					<value>

						<ThoughtDef>
							<defName>ST_MyRivalsAreCaptured</defName>
							<workerClass>SimsTraits.ThoughtWorker_MyRivalsAreCaptured</workerClass>
							<stages>
								<li>
									<label>Rival Captured</label>
									<description> My rivals are at where they belong - on their knees!</description>
									<baseMoodEffect>1</baseMoodEffect>
								</li>
							</stages>
						</ThoughtDef>

					</value>
				</li>

				<li Class="PatchOperationAdd" MayRequire="Ludeon.RimWorld.Anomaly">
					<xpath>Defs/TraitDef[defName="VTE_WorldWeary"]/degreeDatas/li</xpath>
					<value>
						<allowedMeditationFocusTypes>
							<li MayRequire="Ludeon.RimWorld.Anomaly">Void</li>
						</allowedMeditationFocusTypes>
					</value>
				</li>

				<li Class="PatchOperationReplace">
					<xpath>Defs/TraitDef[defName="VTE_Squeamish"]/degreeDatas/li/description</xpath>
					<value>
						<description>{PAWN_nameDef} can’t stand the sight of blood or corpses, often vomiting when exposed. {PAWN_possessive} panic reflexes, however, make {PAWN_objective} surprisingly good at avoiding bleeding wounds.</description>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>Defs/TraitDef[defName="VTE_AnimalLover"]/degreeDatas/li/description</xpath>
					<value>
						<description>{PAWN_nameDef} can't stand cruelty toward animals and strive to rescue as many as they can. {PAWN_pronoun} feels happier when nuzzled, but is more deeply upset when losing one. {PAWN_pronoun} also refuses to butcher animals.</description>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>