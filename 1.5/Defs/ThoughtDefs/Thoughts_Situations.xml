<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThoughtDef>
    <defName>ST_Naive</defName>
    <thoughtClass>SimsTraits.Thought_Naive</thoughtClass>
    <workerClass>SimsTraits.ThoughtWorker_Naive</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <requiredTraits>
      <li>ST_Naive</li>
    </requiredTraits>
    <stages>
      <li>
        <label>I like {OTHERPAWN_objective}</label>
        <baseOpinionOffset>25</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>ST_Narcissist</defName>
    <workerClass>SimsTraits.ThoughtWorker_Narcissist</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <requiredTraits>
      <li>ST_Narcissist</li>
    </requiredTraits>
    <stages>
      <li>
        <label>Feeling pretty</label>
        <description>The mirror told me I’m the prettiest person in the world!</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
      <li>
        <label>Feeling ugly</label>
        <description>The mirror told me to unalive myself.</description>
        <baseMoodEffect>-1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>ST_LoyalThought</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>10000</durationDays>
    <stackLimit>300</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <validWhileDespawned>true</validWhileDespawned>
    <requiredTraits>
      <li>ST_Loyal</li>
    </requiredTraits>
    <stages>
      <li>
        <label>my dearest</label>
        <baseOpinionOffset>100</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>ST_VeganVsCarnist</defName>
    <thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>SimsTraits.ThoughtWorker_VeganVsCarnist</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>vegan vs carnist</label>
        <baseOpinionOffset>-5</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>WearingLeatheryApparel</defName>
    <workerClass>SimsTraits.ThoughtWorker_LeatherApparel</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>tainted {0}</label>
        <description>I am wearing a piece of apparel that made from animal products. It creeps me out and feels dirty.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
      <li>
        <label>tainted {0} (+1)</label>
        <description>I am wearing two pieces of apparel that made from animal products. It creeps me out and feels dirty.</description>
        <baseMoodEffect>-8</baseMoodEffect>
      </li>
      <li>
        <label>tainted {0} (+2)</label>
        <description>I am wearing three pieces of apparel that made from animal products. It creeps me out and feels dirty.</description>
        <baseMoodEffect>-11</baseMoodEffect>
      </li>
      <li>
        <label>tainted {0} etc</label>
        <description>I am wearing four or more pieces of apparel that made from animal products. It creeps me out and feels dirty.</description>
        <baseMoodEffect>-14</baseMoodEffect>
      </li>
    </stages>
    <nullifyingHediffs>
      <li MayRequire="Ludeon.RimWorld.Anomaly">Inhumanized</li>
    </nullifyingHediffs>
  </ThoughtDef>
  
   <ThoughtDef>
    <defName>ST_NoPokerTable</defName>
    <workerClass>SimsTraits.ThoughtWorker_NoPokerTable</workerClass>
    <stages>
      <li>
        <label>No poker table</label>
        <description>Just one game please, my fingers are itchy!</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  
  <ThoughtDef>
    <defName>ST_OneOfUs</defName>
    <thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>SimsTraits.ThoughtWorker_OneOfUs</workerClass>
    <developmentalStageFilter>Baby, Child</developmentalStageFilter>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>One of us</label>
        <baseOpinionOffset>25</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>
  
  <ThoughtDef>
    <defName>ST_SomethingIsOff</defName>
    <thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>SimsTraits.ThoughtWorker_SomethingIsOff</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>something's off</label>
        <baseOpinionOffset>-5</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>
</Defs>
