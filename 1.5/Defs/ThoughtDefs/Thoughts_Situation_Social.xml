<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThoughtDef>
    <defName>ST_Naive</defName>
    <thoughtClass>SimsTraits.Thought_Naive</thoughtClass>
    <workerClass>SimsTraits.ThoughtWorker_Naive</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <requiredTraits>
      <li>ST_Naive</li>
    </requiredTraits>
    <stages>
      <li>
        <label>I like {OTHERPAWN_objective}</label>
        <baseOpinionOffset>25</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>ST_Narcissist</defName>
    <workerClass>SimsTraits.ThoughtWorker_Narcissist</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <requiredTraits>
      <li>ST_Narcissist</li>
    </requiredTraits>
    <stages>
      <li>
        <label>Feeling pretty</label>
        <description>The mirror told me I’m the prettiest person in the world!</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
      <li>
        <label>Feeling ugly</label>
        <description>The mirror told me to unalive myself.</description>
        <baseMoodEffect>-1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>ST_LoyalThought</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>10000</durationDays>
    <stackLimit>300</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <validWhileDespawned>true</validWhileDespawned>
    <requiredTraits>
      <li>ST_Loyal</li>
    </requiredTraits>
    <stages>
      <li>
        <label>my dearest</label>
        <baseOpinionOffset>100</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>
  
</Defs>
