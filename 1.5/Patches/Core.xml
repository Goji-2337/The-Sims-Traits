<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThoughtDef[defName="Pretty"]/stages</xpath>
				<value>
					<li>
						<label>Physically alluring</label>
						<baseOpinionOffset>60</baseOpinionOffset>
					</li>
					<li>
						<label>Otherworldly beauty</label>
						<baseOpinionOffset>80</baseOpinionOffset>
					</li>
				</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThoughtDef[defName="Ugly"]/stages</xpath>
				<value>
					<li>
						<label>Physically abhorrent</label>
						<baseOpinionOffset>-60</baseOpinionOffset>
					</li>
					<li>
						<label>Nightmare fuel</label>
						<baseOpinionOffset>-80</baseOpinionOffset>
					</li>
				</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThoughtDef[defName="AteNutrientPasteMeal"]/nullifyingTraits</xpath>
				<value>
					<li>ST_HealthFreak</li>
				</value>
			</li>

			<li Class="PatchOperationConditional">
				<xpath>Defs/ThoughtDef[defName="AteLavishMeal"]/nullifyingTraits</xpath>
				<match Class="PatchOperationAdd">
					<xpath>Defs/ThoughtDef[defName="AteLavishMeal"]/nullifyingTraits</xpath>
					<value>
						<li>ST_HealthFreak</li>
					</value>
				</match>
				<nomatch Class="PatchOperationAdd">
					<xpath>Defs/ThoughtDef[defName="AteLavishMeal"]</xpath>
					<value>
						<nullifyingTraits>
							<li>ST_HealthFreak</li>
						</nullifyingTraits>
					</value>
				</nomatch>
			</li>

			<li Class="PatchOperationConditional">
				<xpath>Defs/ThoughtDef[defName="AteFineMeal"]/nullifyingTraits</xpath>
				<match Class="PatchOperationAdd">
					<xpath>Defs/ThoughtDef[defName="AteFineMeal"]/nullifyingTraits</xpath>
					<value>
						<li>ST_HealthFreak</li>
					</value>
				</match>
				<nomatch Class="PatchOperationAdd">
					<xpath>Defs/ThoughtDef[defName="AteFineMeal"]</xpath>
					<value>
						<nullifyingTraits>
							<li>ST_HealthFreak</li>
						</nullifyingTraits>
					</value>
				</nomatch>
			</li>
		</operations>
	</Operation>
</Patch>